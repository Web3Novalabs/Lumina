# Sentry - Error Monitoring
# Get these from https://sentry.io/settings/<org>/projects/<project>/keys/
NEXT_PUBLIC_SENTRY_DSN=

# Used during build for source map uploads (optional)
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Required frontend runtime config
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001
NEXT_PUBLIC_STELLAR_NETWORK=testnet

# Soroban RPC Configuration
# URL of the Soroban RPC server for contract interactions
NEXT_PUBLIC_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org

# Stellar Network Configuration
# Network passphrase for transaction signing (e.g., "Test SDF Network ; September 2015" for testnet)
NEXT_PUBLIC_NETWORK_PASSPHRASE=

# Contract Configuration
# ID of the deployed Nevo smart contract
NEXT_PUBLIC_CONTRACT_ID=

# API Rate Limiting
# Maximum number of API requests allowed within the rate limit window
NEXT_PUBLIC_API_RATE_LIMIT_MAX_REQUESTS=60
# Time window in milliseconds for rate limiting
NEXT_PUBLIC_API_RATE_LIMIT_WINDOW_MS=60000
