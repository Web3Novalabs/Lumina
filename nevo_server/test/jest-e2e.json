{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": [
      "ts-jest",
      {
        "useESM": true
      }
    ]
  },
  "extensionsToTreatAsEsm": [
    ".ts"
  ],
  "transformIgnorePatterns": [
    "/node_modules/(?!(@stellar/stellar-sdk|@noble/.*|uint8array-extras)/)"
  ],
  "moduleNameMapper": {
    "^(\\.\\.?/.*)\\.js$": "$1"
  }
}
